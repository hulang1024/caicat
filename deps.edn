{:paths ["src" "resources"]
 :deps
 {org.clojure/clojure {:mvn/version "1.12.5"}
  org.clojure/clojurescript {:mvn/version "1.12.145"}
  org.clojure/core.async {:mvn/version "1.9.865"}
  com.taoensso/timbre {:mvn/version "6.8.0"}
  thheller/shadow-cljs {:mvn/version "3.1.7"}
  ring/ring-jetty-adapter {:mvn/version "1.12.1"}
  metosin/reitit {:mvn/version "0.11.0-rc1"}
  cheshire/cheshire {:mvn/version "6.2.0"}
  hiccup/hiccup {:mvn/version "2.0.0"}
  reagent/reagent {:mvn/version "2.0.1"}
  cljs-ajax/cljs-ajax {:mvn/version "0.8.1"}}
 :aliases
 {:build {:main-opts  ["-m" "caicat.webui.build"]
          :extra-deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}}
  :serve {:main-opts  ["-m" "caicat.server.main"]
          :extra-deps
          {cljfmt/cljfmt {:mvn/version "0.5.7"}
           nrepl/nrepl {:mvn/version "1.7.0"}
           com.bhauman/rebel-readline {:mvn/version "0.1.4"}
           com.cemerick/piggieback {:mvn/version "0.2.2"}}}
  :nrepl {:extra-deps {com.bhauman/rebel-readline-nrepl {:mvn/version "0.1.11"}}
          :exec-fn rebel-readline.nrepl/connect
          :exec-args {:background-print false}
          :main-opts ["-m" "rebel-readline.nrepl.main"]
          :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}}}

